# --- API
API_PORT=8000
DATABASE_URL=postgresql://techops:change_me@postgres_app:5432/techops
API_KEY=
REQUIRE_API_KEY=false
RATE_LIMIT_RPM=0
ENFORCE_RBAC=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=
VITE_INTAKE_MODE=webhook
VITE_WEBHOOK_URL=http://localhost:5678/webhook/ticket-intake

